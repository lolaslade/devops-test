# Ignore directories generated by Composer
/drush/contrib/
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/

# Ignore sensitive information
/web/sites/*/settings.local.php
/web/sites/*/services.local.yml

# Ignore SimpleTest multi-site environment.
/web/sites/simpletest

# Ignore files generated by PhpStorm
/.idea/

# Ignore .env files.
/.env
/.env.local.php

# Ignore cache/files folders.
/cache/
/files/
/web/sites/*/files/
# For symlink
/web/sites/*/files
/web/files

# Ignore .htaccess files generated by Drupal.
/cache/twig/.htaccess
/config/sync/.htaccess
